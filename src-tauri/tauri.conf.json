{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt Saver",
  "version": "0.1.0",
  "identifier": "ua.promptsaver.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prompt Saver",
        "width": 1180,
        "height": 800,
        "minWidth": 940,
        "minHeight": 650,
        "center": true
      }
    ],
    "security": { "csp": "default-src 'self'; connect-src 'self' https://api.openai.com; img-src 'self' asset: data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "windows": { "nsis": { "installMode": "currentUser", "displayLanguageSelector": false } }
  }
}
